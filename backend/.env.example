# Server
HOST=0.0.0.0
PORT=8000
DEBUG=true
CORS_ORIGINS=*

# Runtime paths
RUNTIME_DIR=./runtime
UPLOAD_DIR=./runtime/uploads
DB_PATH=./runtime/search.sqlite

# Search tuning
SEARCH_CANDIDATES=200
LEXICON_LIMIT=5000
JOB_WORKERS=1
METRICS_SAMPLE_SIZE=18

# Optional local LLM settings
LLM_ENABLED=false
LLM_PROVIDER=local_qwen
LLM_MODEL_PATH=../models/qwen2.5-3b-instruct
LLM_DEVICE=cpu
LLM_MAX_NEW_TOKENS=256
LLM_TEMPERATURE=0.1
